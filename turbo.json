{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "VISEPANDA_ANON_SESSION_SECRET",
    "VISEPANDA_ANON_SESSION_KEY_ID",
    "VISEPANDA_ANON_SESSION_PREVIOUS_SECRET",
    "VISEPANDA_ANON_SESSION_PREVIOUS_KEY_ID",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "VISEPANDA_ANON_TURN_LIMIT",
    "VISEPANDA_IP_HASH_SALT",
    "VISEPANDA_COPILOT_IP_RATE_LIMIT_MINUTE",
    "VISEPANDA_COPILOT_IP_RATE_LIMIT_HOUR",
    "VISEPANDA_COPILOT_MAX_INPUT_CODE_UNITS",
    "VISEPANDA_COPILOT_MAX_OUTPUT_TOKENS",
    "VISEPANDA_AUTHENTICATED_RATE_LIMIT_MINUTE",
    "VISEPANDA_AUTHENTICATED_RATE_LIMIT_HOUR",
    "VISEPANDA_TELEMETRY_IDENTITY_RATE_LIMIT_MINUTE",
    "VISEPANDA_TELEMETRY_IDENTITY_RATE_LIMIT_HOUR",
    "VISEPANDA_TELEMETRY_IP_RATE_LIMIT_MINUTE",
    "VISEPANDA_TELEMETRY_IP_RATE_LIMIT_HOUR",
    "RESEND_API_KEY",
    "EARLY_ACCESS_EMAIL_FROM",
    "VERCEL",
    "VISEPANDA_RUNTIME_MODE",
    "DASHSCOPE_API_KEY",
    "DASHSCOPE_BASE_URL",
    "DEEPSEEK_API_KEY",
    "DEEPSEEK_BASE_URL",
    "MOONSHOT_API_KEY",
    "MOONSHOT_BASE_URL",
    "ZHIPU_API_KEY",
    "ZHIPU_BASE_URL",
    "VISEPANDA_MODEL_*",
    "PLANNING_REWRITE_ENABLED"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@visepanda/app-mobile#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
