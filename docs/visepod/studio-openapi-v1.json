{
  "openapi": "3.1.0",
  "info": {
    "title": "VisePod Studio Binding API",
    "version": "1.0.0",
    "description": "Private VisePod Studio contract. The executable Zod source of truth is packages/domain/src/visepod/studio.ts. Breaking changes require a new major contract version."
  },
  "servers": [
    { "url": "https://ops-development.example.invalid", "description": "Development placeholder: deploy with the development Ops project and development-only grant records." },
    { "url": "https://ops.example.invalid", "description": "Production placeholder: deploy with the production Ops project and production-only grant records." }
  ],
  "paths": {
    "/api/ops/visepod/provisioning-token": {
      "post": {
        "operationId": "issueVisePodProvisioningToken",
        "summary": "Issue an eight-hour VisePod Studio provisioning token",
        "security": [{ "opsSession": [] }],
        "responses": {
          "201": { "description": "Token issued", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ProvisioningTokenIssued" }, "examples": { "issued": { "$ref": "#/components/examples/provisioningTokenIssued" } } } } },
          "403": { "$ref": "#/components/responses/ProvisioningDenied" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/ops/visepod/users/resolve": {
      "post": {
        "operationId": "resolveVisePodStudioUserExactly",
        "summary": "Resolve exactly one user by full email or UUID",
        "security": [{ "provisioningGrant": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExactUserLookupRequest" } } } },
        "responses": {
          "200": { "description": "One minimized user projection", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExactUserLookupResponse" }, "examples": { "resolved": { "$ref": "#/components/examples/exactUserLookup" } } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/ProvisioningDenied" },
          "404": { "$ref": "#/components/responses/UserNotFound" },
          "429": { "$ref": "#/components/responses/UserLookupRateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/ops/visepod/devices/{deviceId}/binding": {
      "get": {
        "operationId": "getVisePodDeviceBinding",
        "summary": "Read one known device binding",
        "security": [{ "provisioningGrant": [] }],
        "parameters": [{ "$ref": "#/components/parameters/deviceId" }],
        "responses": {
          "200": { "description": "Known device, either unbound or actively bound", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingRead" }, "examples": { "unbound": { "$ref": "#/components/examples/unboundBindingRead" }, "active": { "$ref": "#/components/examples/activeBindingRead" } } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/ProvisioningDenied" },
          "404": { "$ref": "#/components/responses/DeviceNotFound" }
        }
      },
      "put": {
        "operationId": "bindVisePodDevice",
        "summary": "Bind or explicitly rebind one known device",
        "security": [{ "provisioningGrant": [] }],
        "parameters": [{ "$ref": "#/components/parameters/deviceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindRequest" } } } },
        "responses": {
          "201": { "description": "First binding", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingMutation" }, "examples": { "created": { "$ref": "#/components/examples/bindingCreated" } } } } },
          "200": { "description": "Explicit rebind or idempotent replay", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingMutation" }, "examples": { "rebound": { "$ref": "#/components/examples/bindingRebound" } } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/ProvisioningDenied" },
          "404": { "$ref": "#/components/responses/DeviceOrUserNotFound" },
          "409": { "$ref": "#/components/responses/BindingConflict" }
        }
      },
      "delete": {
        "operationId": "revokeVisePodDeviceBinding",
        "summary": "Revoke one active device binding",
        "security": [{ "provisioningGrant": [] }],
        "parameters": [{ "$ref": "#/components/parameters/deviceId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RevokeRequest" } } } },
        "responses": {
          "200": { "description": "Binding revoked", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BindingMutation" }, "examples": { "revoked": { "$ref": "#/components/examples/bindingRevoked" } } } } },
          "400": { "$ref": "#/components/responses/InvalidRequest" },
          "403": { "$ref": "#/components/responses/ProvisioningDenied" },
          "404": { "$ref": "#/components/responses/DeviceNotFound" },
          "409": { "$ref": "#/components/responses/BindingConflict" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "opsSession": { "type": "apiKey", "in": "cookie", "name": "ops-session", "description": "Existing verified Ops session; never replace it with a provisioning token." },
      "provisioningGrant": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque", "description": "Short-lived visepod.provision token. Store only in macOS Keychain." }
    },
    "parameters": {
      "deviceId": { "name": "deviceId", "in": "path", "required": true, "schema": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,64}$" } }
    },
    "schemas": {
      "ProvisioningTokenIssued": { "type": "object", "additionalProperties": false, "required": ["ok", "token", "scope", "environment", "expiresAt"], "properties": { "ok": { "const": true }, "token": { "type": "string", "minLength": 24, "maxLength": 512, "pattern": "^[A-Za-z0-9._~-]+$" }, "scope": { "const": "visepod.provision" }, "environment": { "enum": ["development", "production"] }, "expiresAt": { "type": "string", "format": "date-time" } } },
      "ExactUserLookupRequest": { "type": "object", "additionalProperties": false, "properties": { "email": { "type": "string", "format": "email", "maxLength": 320 }, "userId": { "type": "string", "format": "uuid" } }, "oneOf": [{ "required": ["email"], "not": { "required": ["userId"] } }, { "required": ["userId"], "not": { "required": ["email"] } }] },
      "ExactUserLookupResponse": { "type": "object", "additionalProperties": false, "required": ["user"], "properties": { "user": { "$ref": "#/components/schemas/ResolvedUser" } } },
      "ResolvedUser": { "type": "object", "additionalProperties": false, "required": ["userId", "displayName", "emailHint"], "properties": { "userId": { "type": "string", "format": "uuid" }, "displayName": { "type": ["string", "null"], "maxLength": 100 }, "emailHint": { "type": ["string", "null"], "pattern": "^[^@\\s]*\\*{3,}[^@\\s]*@[^@\\s]+$" } } },
      "Binding": { "type": "object", "additionalProperties": false, "required": ["deviceId", "userId", "state", "boundAt", "boundBy"], "properties": { "deviceId": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,64}$" }, "userId": { "type": "string", "format": "uuid" }, "state": { "const": "active" }, "boundAt": { "type": "string", "format": "date-time" }, "boundBy": { "type": "string", "format": "uuid" } } },
      "BindingRead": { "type": "object", "additionalProperties": false, "required": ["binding"], "properties": { "binding": { "oneOf": [{ "$ref": "#/components/schemas/Binding" }, { "type": "null" }] } } },
      "BindRequest": { "type": "object", "additionalProperties": false, "required": ["userId", "idempotencyKey", "reason"], "properties": { "userId": { "type": "string", "format": "uuid" }, "idempotencyKey": { "type": "string", "format": "uuid" }, "reason": { "type": "string", "minLength": 10, "maxLength": 500 } } },
      "RevokeRequest": { "type": "object", "additionalProperties": false, "required": ["idempotencyKey", "reason"], "properties": { "idempotencyKey": { "type": "string", "format": "uuid" }, "reason": { "type": "string", "minLength": 10, "maxLength": 500 } } },
      "BindingMutation": { "type": "object", "additionalProperties": false, "required": ["outcome", "idempotencyHit", "binding"], "properties": { "outcome": { "enum": ["created", "rebound", "revoked"] }, "idempotencyHit": { "type": "boolean" }, "binding": { "oneOf": [{ "$ref": "#/components/schemas/Binding" }, { "type": "null" }] } } },
      "Error": { "type": "object", "additionalProperties": false, "required": ["error"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "enum": ["INVALID_REQUEST", "PROVISIONING_ACCESS_DENIED", "USER_LOOKUP_RATE_LIMITED", "USER_LOOKUP_UNAVAILABLE", "DEVICE_NOT_FOUND", "USER_NOT_FOUND", "IDEMPOTENCY_KEY_CONFLICT", "BINDING_STATE_CONFLICT"] } } } } }
    },
    "responses": {
      "InvalidRequest": { "description": "Malformed path, body, or bearer form", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "ProvisioningDenied": { "description": "Grant or current permission rejected", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "UserNotFound": { "description": "Exact user lookup missed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "DeviceNotFound": { "description": "Exact device ID is outside the private catalog", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "DeviceOrUserNotFound": { "description": "Exact device or requested user is absent", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "UserLookupRateLimited": { "description": "Exact lookup window exhausted; response includes Retry-After", "headers": { "Retry-After": { "schema": { "type": "integer", "minimum": 1 } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "BindingConflict": { "description": "Changed idempotency payload or invalid current binding state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "Unavailable": { "description": "A private dependency is unavailable; no fallback data is returned", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    },
    "examples": {
      "provisioningTokenIssued": { "value": { "ok": true, "token": "fixture.provisioning-token.000000000000000000000001", "scope": "visepod.provision", "environment": "development", "expiresAt": "2030-01-01T08:00:00.000Z" } },
      "exactUserLookup": { "value": { "user": { "userId": "11111111-1111-4111-8111-111111111111", "displayName": null, "emailHint": "f***@example.invalid" } } },
      "unboundBindingRead": { "value": { "binding": null } },
      "activeBindingRead": { "value": { "binding": { "deviceId": "fixture-device-001", "userId": "11111111-1111-4111-8111-111111111111", "state": "active", "boundAt": "2030-01-01T00:00:00.000Z", "boundBy": "22222222-2222-4222-8222-222222222222" } } },
      "bindingCreated": { "value": { "outcome": "created", "idempotencyHit": false, "binding": { "deviceId": "fixture-device-001", "userId": "11111111-1111-4111-8111-111111111111", "state": "active", "boundAt": "2030-01-01T00:00:00.000Z", "boundBy": "22222222-2222-4222-8222-222222222222" } } },
      "bindingRebound": { "value": { "outcome": "rebound", "idempotencyHit": false, "binding": { "deviceId": "fixture-device-001", "userId": "33333333-3333-4333-8333-333333333333", "state": "active", "boundAt": "2030-01-01T01:00:00.000Z", "boundBy": "22222222-2222-4222-8222-222222222222" } } },
      "bindingRevoked": { "value": { "outcome": "revoked", "idempotencyHit": false, "binding": null } }
    }
  }
}
