{
  "name": "@visepanda/app-mobile",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "android": "expo start --android",
    "build": "tsc -p tsconfig.json --noEmit",
    "export": "expo export --platform ios",
    "ios": "expo start --ios",
    "start": "expo start",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check App.tsx app.json src"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@visepanda/domain": "workspace:*",
    "@visepanda/ui": "workspace:*",
    "expo": "~55.0.0",
    "expo-clipboard": "~55.0.15",
    "expo-file-system": "~55.0.24",
    "expo-secure-store": "~55.0.16",
    "expo-speech": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.10"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
